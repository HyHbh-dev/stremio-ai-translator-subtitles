{
  "name": "stremio-ai-translator-subtitles",
  "version": "1.1.0",
  "description": "Stremio addon that uses LLM to translate subtitles into Chinese when no Chinese subtitles are available",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js --dev",
    "test": "node --test test/unit.test.js test/translation-flow.test.js test/e2e.test.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/stremio-ai-subtitles.exe --compress GZip"
  },
  "keywords": [
    "stremio",
    "addon",
    "subtitles",
    "ai",
    "translation",
    "llm",
    "openai",
    "deepseek"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "stremio-addon-sdk": "^1.6.2",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5"
  },
  "pkg": {
    "assets": [
      "src/**/*.js"
    ],
    "scripts": [
      "src/**/*.js"
    ]
  }
}
