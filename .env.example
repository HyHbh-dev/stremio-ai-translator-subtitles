# ============================================
# Stremio AI Translator Subtitles - 配置文件
# 复制此文件为 .env 并填写你的配置
# ============================================

# 服务端口
PORT=7000

# 大模型 API 配置 (支持 OpenAI 兼容接口)
# API Key (Magpie 本地服务可不填，留空即可)
LLM_API_KEY=

# API 基础地址 (根据你使用的服务商修改)
# Magpie 本地:           http://127.0.0.1:3425/v1
# OpenAI:                https://api.openai.com/v1
# DeepSeek:              https://api.deepseek.com/v1
# Moonshot:              https://api.moonshot.cn/v1
# 通义千问:               https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=http://127.0.0.1:3425/v1

# 模型名称
# B站 Index-Translate-9B:    bili-translate/Index-Translate-9B (推荐，专为翻译优化)
# B站 Index-Translate-2B:    bili-translate/Index-Translate-2B (最快)
# B站 Index-Translate-35B:   bili-translate/Index-Translate-35B-A3B (效果最佳)
# OpenAI:                    gpt-4o-mini / gpt-4o
# DeepSeek:                  deepseek-chat
# Moonshot:                  moonshot-v1-8k
LLM_MODEL=bili-translate/Index-Translate-9B

# 翻译目标语言
TARGET_LANG=zh

# 源字幕语言 (当该语言字幕可用时进行翻译)
SOURCE_LANG=en

# 字幕源选择
# auto   依次尝试：新版 → 旧版 → 官方 CDN（推荐）
# rest   只用新版 REST，需要 API Key，匿名每天 5 次下载
# legacy 只用旧接口 XML-RPC，免 Key，但匿名下载只返回 VIP 占位字幕，需要账号
# cdn    只用 Stremio 官方插件的 CDN，免 Key、不限次数（借用第三方服务）
SUBTITLE_SOURCE=auto

# OpenSubtitles API (新版 REST，用于获取源字幕)
# 注册地址: https://www.opensubtitles.com/consumers
# 注意: REST API 路径是 /api/v1（/api/v2 会返回 404）
OPENSUBTITLES_API_KEY=your-opensubtitles-api-key
OPENSUBTITLES_USER_AGENT=StremioAITranslator v1.0
# 接口地址，一般不用改（需要走自建代理时再改）
OPENSUBTITLES_BASE_URL=https://api.opensubtitles.com/api/v1

# OpenSubtitles 旧接口 (XML-RPC)
# 只有用 legacy 源时才需要；匿名可搜索，但下载到的是占位字幕，必须填账号
OPENSUBTITLES_LEGACY_URL=https://api.opensubtitles.org/xml-rpc
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Stremio 官方字幕插件的 CDN（免 Key 兜底通道）
STREMIO_CDN_URL=https://opensubtitles-v3.strem.io

# 翻译批次大小 (每批发送给大模型的字幕条数，建议 20-50)
TRANSLATE_BATCH_SIZE=30

# 缓存过期时间 (小时)
CACHE_TTL_HOURS=24

# 对外访问地址（可选）
# 部署在反向代理/远程服务器时填写，例如 https://sub.example.com
# 不填则自动使用 Stremio 请求里的 Host
PUBLIC_URL=
