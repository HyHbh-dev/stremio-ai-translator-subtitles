# ============================================
# Stremio AI Translator Subtitles - 配置文件
# 复制此文件为 .env 并填写你的配置
# ============================================

# 服务端口
PORT=7000

# 大模型 API 配置 (支持 OpenAI 兼容接口)
# API Key (Magpie 本地服务可不填，留空即可)
LLM_API_KEY=

# API 基础地址 (根据你使用的服务商修改)
# Magpie 本地:           http://127.0.0.1:3425/v1
# OpenAI:                https://api.openai.com/v1
# DeepSeek:              https://api.deepseek.com/v1
# Moonshot:              https://api.moonshot.cn/v1
# 通义千问:               https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=http://127.0.0.1:3425/v1

# 模型名称
# B站 Index-Translate-9B:    bili-translate/Index-Translate-9B (推荐，专为翻译优化)
# B站 Index-Translate-2B:    bili-translate/Index-Translate-2B (最快)
# B站 Index-Translate-35B:   bili-translate/Index-Translate-35B-A3B (效果最佳)
# OpenAI:                    gpt-4o-mini / gpt-4o
# DeepSeek:                  deepseek-chat
# Moonshot:                  moonshot-v1-8k
LLM_MODEL=bili-translate/Index-Translate-9B

# 翻译目标语言
TARGET_LANG=zh

# 源字幕语言 (当该语言字幕可用时进行翻译)
SOURCE_LANG=en

# OpenSubtitles API (用于获取源字幕)
# 注册地址: https://api.opensubtitles.com/api/v2
OPENSUBTITLES_API_KEY=your-opensubtitles-api-key
OPENSUBTITLES_USER_AGENT=StremioAITranslator v1.0

# 翻译批次大小 (每批发送给大模型的字幕条数，建议 20-50)
TRANSLATE_BATCH_SIZE=30

# 缓存过期时间 (小时)
CACHE_TTL_HOURS=24
