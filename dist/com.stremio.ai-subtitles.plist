<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  用法：
  1. 把下面两处 /Users/你的用户名/... 改成你的真实路径
     （Apple 芯片用 -macos-arm64，Intel 用 -macos-x64）
  2. 复制到 ~/Library/LaunchAgents/
  3. launchctl load ~/Library/LaunchAgents/com.stremio.ai-subtitles.plist

  取消：launchctl unload ~/Library/LaunchAgents/com.stremio.ai-subtitles.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stremio.ai-subtitles</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/你的用户名/Applications/stremio-ai-subtitles/stremio-ai-subtitles-macos-arm64</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/你的用户名/Applications/stremio-ai-subtitles</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/stremio-ai-subtitles.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/stremio-ai-subtitles.err.log</string>
</dict>
</plist>
